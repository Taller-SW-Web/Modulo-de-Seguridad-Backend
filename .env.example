# Plantilla de variables de entorno (TEC-INFRA-T001).
# Copiar a .env (ignorado por Git) y completar con los valores privados del
# proyecto G7 real. Nunca subir valores reales al repositorio.
# Los hosts/usuarios se toman de Connect del proyecto correcto; no adivinar región.

# Runtime: conexión JDBC del backend (session pooler 5432 si IPv4, directa si hay IPv6).
# Incluir sslmode=verify-full y la CA del proyecto en la URL.
DB_JDBC_URL=jdbc:postgresql://HOST:5432/BASE?sslmode=verify-full
DB_USERNAME=
DB_PASSWORD=

# Perfil 'migration': identidad migradora separada del runtime.
DB_MIGRATION_JDBC_URL=jdbc:postgresql://HOST:5432/BASE?sslmode=verify-full
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=

# Perfiles Spring activos (runtime por defecto; 'migration' para migrar).
SPRING_PROFILES_ACTIVE=
